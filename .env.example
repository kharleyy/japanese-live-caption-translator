# Copy this file to .env and fill in the key locally.
# Never commit .env.
# The defaults use DeepSeek. Any OpenAI-compatible endpoint can be configured.
API_KEY=
API_BASE_URL=https://api.deepseek.com
API_MODEL=deepseek-chat
API_TIMEOUT_SECONDS=30
API_MAX_OUTPUT_TOKENS=512
# Leave prices at 0 until the account's current unit prices are confirmed.
API_INPUT_PRICE_PER_MILLION=0
API_OUTPUT_PRICE_PER_MILLION=0
FINAL_DEBOUNCE_MS=1500
TRANSLATION_RETRY_SECONDS=5,15,60,300
HISTORY_PORT=8765

# Legacy DEEPSEEK_* names are still accepted when API_* is not set.

